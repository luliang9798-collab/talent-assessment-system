{
  "version": 2,
  "builds": [
    { "src": "backend-nodejs/server-render.js", "use": "@vercel/node" },
    { "src": "frontend/**/*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend-nodejs/server-render.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
