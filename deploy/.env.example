# ============================================================
# 人才测评系统 - 环境变量配置模板
# 复制本文件为 .env 并修改对应值（生产环境务必修改 JWT_SECRET）
# ============================================================

# 服务监听端口（Nginx 反向代理时通常保持 3000）
PORT=3000

# JWT 签名密钥（生产环境务必改为 32 位以上随机字符串，例如：openssl rand -hex 32）
JWT_SECRET=change-this-to-a-strong-random-secret-key-at-least-32-chars

# 数据库文件路径（绝对路径或相对路径均可；生产建议放在独立数据盘）
DB_PATH=./talent_assessment_new.db

# 前端访问来源（CORS 白名单，留空表示允许同源；多个用逗号分隔）
# FRONTEND_URL=https://assessment.your-company.com

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 默认管理员账号（仅首次初始化数据库时生效；已存在则忽略）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
